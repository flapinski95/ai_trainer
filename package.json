{
  "name": "ai-trainer",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "start": "next start --hostname 127.0.0.1",
    "build:web": "next build",
    "test": "tsx --test backend/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:webhook && npm run build:worker && npm run build:garmin && npm run build:push",
    "build:webhook": "esbuild backend/strava-webhook/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/strava-webhook/index.js",
    "build:worker": "esbuild backend/strava-worker/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/strava-worker/index.js",
    "build:garmin": "esbuild backend/garmin/ingress.ts backend/garmin/worker.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist/garmin",
    "build:push": "esbuild backend/push/handler.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/push/index.js"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/google": "^4.0.105",
    "@ai-sdk/openai": "^4.0.102",
    "@ai-sdk/react": "^4.0.157",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-kms": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@garmin/fitsdk": "^21.218.0",
    "ai": "^7.0.153",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  }
}
